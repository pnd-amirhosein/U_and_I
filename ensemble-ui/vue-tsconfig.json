{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist-vue",
    "rootDir": "./packages/vue",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "ensemble-ui": [
        "./dist/types/index.d.ts"
      ],
      "ensemble-ui/components/*": [
        "./dist/components/*"
      ]
    }
  },
  "include": [
    "./packages/vue/**/*.ts"
  ]
}
